# Production/preview configuration. Vercel stores these values as encrypted
# environment variables. Use this file only as a key/reference template.
APP_ENV=deployment

# Generation routing. Groq is OpenAI-compatible; Gemini remains available as fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GENERATION_INPUT_COST_PER_MILLION_USD=0
GENERATION_OUTPUT_COST_PER_MILLION_USD=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GENERATION_PROVIDER=auto
GENERATION_PRIMARY_PROVIDER=gemini
GENERATION_FALLBACK_PROVIDER=groq
AI_GATEWAY_MODEL=google/gemini-2.5-flash
AI_GATEWAY_API_KEY=
EMBEDDING_PROVIDER=gemini
ONLINE_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=384
# Replace only after both Phase 2 reviewers approve a passing report.
ACTIVE_INDEX_NAMESPACE=phase2_SELECTED_AFTER_SIGNOFF
EMBEDDING_NAMESPACE=
# Per-session routes. A dimension is selectable only after its namespace has rows.
EMBEDDING_NAMESPACE_384=gemini_384
EMBEDDING_NAMESPACE_768=gemini_768
EMBEDDING_NAMESPACE_1024=gemini_1024
EMBEDDING_NAMESPACE_2048=gemini_2048
EMBEDDING_NAMESPACE_3072=gemini_3072
EMBEDDING_EXPECTED_DOCUMENT_COUNT=12
EMBEDDING_ACCEPTED_DIMENSIONS=384,768
ONLINE_EMBEDDING_BATCH_SIZE=16
ONLINE_EMBEDDING_RPM=90
GEMINI_EMBEDDING_RPM_LIMIT=
GEMINI_EMBEDDING_TPM_LIMIT=
GEMINI_EMBEDDING_RPD_LIMIT=
GEMINI_EMBEDDING_SAFETY_FACTOR=0.70
OCR_LANGUAGE=eng
OCR_DPI=150

# Neon injects a pooled URL for requests and a direct URL for schema work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTO_CREATE_SCHEMA=false

# Retrieval and chunking. Chunk settings are also used by the admin ingestion job.
TOP_K=5
RETRIEVAL_PROFILE=large
SIMILARITY_THRESHOLD=0.30
CHUNK_SIZE=3000
CHUNK_OVERLAP=300
MIN_CHUNK_SIZE=100
MIN_QUALITY_SCORE=0.1
DATA_DIR=data/rew_data/books

# Application
DEBUG=false
MAX_MEMORY_TURNS=6
OPERATIONS_DASHBOARD_TOKEN=
