# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Embedding Model ───────────────────────────────────────────────────────────
# local: sentence-transformers; gemini: hosted API for serverless deployment
EMBEDDING_PROVIDER=local
# Free multilingual local model — supports English, Arabic, Egyptian Arabic
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ONLINE_EMBEDDING_MODEL=gemini-embedding-2
# Both providers use the same dimension; pgvector supports up to 2,000 dimensions.
EMBEDDING_DIMENSION=384
# Optional isolation name. Empty derives local_384 or gemini_384 automatically.
EMBEDDING_NAMESPACE=

# ── Retrieval Settings ────────────────────────────────────────────────────────
TOP_K=5
# Minimum cosine similarity score (0.0–1.0) to consider a chunk relevant.
# pgvector cosine distances are converted with: score = 1 - distance
# Set lower (0.2) for broader recall, higher (0.4) for stricter relevance.
SIMILARITY_THRESHOLD=0.30

# ── Chunking Settings ─────────────────────────────────────────────────────────
# Approximate characters per chunk (300-500 tokens ≈ 1500-2500 chars for EN)
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MIN_QUALITY_SCORE=0.1

# ── Data Directories ──────────────────────────────────────────────────────────
# Directory containing PDF source files (all categories mixed).
# Alternatively, put category-specific PDFs in data/treatment, data/prevention, data/nutrition.
DATA_DIR=data/rew_data/books

# ── PostgreSQL / pgvector ─────────────────────────────────────────────────────
POSTGRES_DB=creativa_diabetes
POSTGRES_USER=creativa
POSTGRES_PASSWORD=creativa-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://creativa:creativa-local@localhost:5432/creativa_diabetes

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
# Maximum conversation turns to keep in memory (older turns are dropped)
MAX_MEMORY_TURNS=6
