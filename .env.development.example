# Local development configuration. Copy to .env.development and keep it private.
APP_ENV=development

# Generation routing. "auto" retries Groq if Gemini is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GENERATION_INPUT_COST_PER_MILLION_USD=0
GENERATION_OUTPUT_COST_PER_MILLION_USD=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GENERATION_PROVIDER=auto
GENERATION_PRIMARY_PROVIDER=gemini
GENERATION_FALLBACK_PROVIDER=groq
AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Embeddings: local keeps development free after the model download.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ONLINE_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=384
# ACTIVE_INDEX_NAMESPACE is promoted only after the Phase 2 report is approved.
ACTIVE_INDEX_NAMESPACE=
# Legacy migration fallback; keep empty when ACTIVE_INDEX_NAMESPACE is used.
EMBEDDING_NAMESPACE=
# Per-session routes. A dimension is selectable only after its namespace has rows.
EMBEDDING_NAMESPACE_384=gemini_384
EMBEDDING_NAMESPACE_768=gemini_768
EMBEDDING_NAMESPACE_1024=gemini_1024
EMBEDDING_NAMESPACE_2048=gemini_2048
EMBEDDING_NAMESPACE_3072=gemini_3072
EMBEDDING_EXPECTED_DOCUMENT_COUNT=12
EMBEDDING_ACCEPTED_DIMENSIONS=384,768
ONLINE_EMBEDDING_BATCH_SIZE=16
ONLINE_EMBEDDING_RPM=90
GEMINI_EMBEDDING_RPM_LIMIT=
GEMINI_EMBEDDING_TPM_LIMIT=
GEMINI_EMBEDDING_RPD_LIMIT=
GEMINI_EMBEDDING_SAFETY_FACTOR=0.70

# Retrieval and chunking
TOP_K=5
RETRIEVAL_PROFILE=balanced
SIMILARITY_THRESHOLD=0.30
# Named retrieval profile controls chunk size/overlap (balanced = 2000/200).
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MIN_QUALITY_SCORE=0.1
OCR_LANGUAGE=eng
OCR_DPI=150
DATA_DIR=data/rew_data/books

# Local PostgreSQL/pgvector from compose.yaml
POSTGRES_DB=creativa_diabetes
POSTGRES_USER=creativa
POSTGRES_PASSWORD=creativa-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://creativa:creativa-local@localhost:5432/creativa_diabetes
DATABASE_URL_UNPOOLED=
AUTO_CREATE_SCHEMA=true

# Application
DEBUG=false
MAX_MEMORY_TURNS=6
OPERATIONS_DASHBOARD_TOKEN=
