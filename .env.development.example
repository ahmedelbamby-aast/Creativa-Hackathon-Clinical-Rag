# Local development configuration. Copy to .env.development and keep it private.
APP_ENV=development

# Gemini generation (and optional hosted embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Embeddings: local keeps development free after the model download.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ONLINE_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=384
EMBEDDING_NAMESPACE=
ONLINE_EMBEDDING_BATCH_SIZE=16
ONLINE_EMBEDDING_RPM=90

# Retrieval and chunking
TOP_K=5
SIMILARITY_THRESHOLD=0.30
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MIN_QUALITY_SCORE=0.1
DATA_DIR=data/rew_data/books

# Local PostgreSQL/pgvector from compose.yaml
POSTGRES_DB=creativa_diabetes
POSTGRES_USER=creativa
POSTGRES_PASSWORD=creativa-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://creativa:creativa-local@localhost:5432/creativa_diabetes
DATABASE_URL_UNPOOLED=
AUTO_CREATE_SCHEMA=true

# Application
DEBUG=false
MAX_MEMORY_TURNS=6
